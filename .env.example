# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
# Download from: APIs & Services → Credentials → your OAuth 2.0 Client ID → Download JSON
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where the OAuth token will be written after the first auth flow.
# Generated automatically by auth_setup.py — copy to server after running locally.
GMAIL_TOKEN_PATH=token.json

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for summarization. Sonnet balances quality and cost.
CLAUDE_MODEL=claude-sonnet-4-6

# Pushover credentials — https://pushover.net/
# App token: create an application at pushover.net/apps/build
# User key: found on your Pushover dashboard
PUSHOVER_APP_TOKEN=...
PUSHOVER_USER_KEY=...

# How many hours back to look when no prior run state exists (first run only).
# Subsequent runs use the timestamp written by the previous run.
DEFAULT_LOOKBACK_HOURS=24
